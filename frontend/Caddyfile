:80 {
    root * /srv
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ws: wss: http: https:; img-src 'self' data:; media-src 'self' blob:;"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
    }

    @immutableAssets path /assets/*
    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

    @publicMetadata path /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png /og-image.png /og-image.svg /site.webmanifest /robots.txt /sitemap.xml /llms.txt
    header @publicMetadata Cache-Control "public, max-age=3600"

    @homeDocument path / /index.html
    header @homeDocument Cache-Control "no-cache"

    @privateRoutes path_regexp privateRoutes ^/(?:admin|[a-z0-9]{3}-[a-z0-9]{4}-[a-z0-9]{3})/?$
    header @privateRoutes {
        X-Robots-Tag "noindex, nofollow, noarchive"
        Cache-Control "no-store"
    }

    @api path /api /api/*
    handle @api {
        reverse_proxy backend:8080
    }

    @ws path /ws /ws/*
    handle @ws {
        reverse_proxy backend:8080
    }

    @rtc path /rtc /rtc/*
    handle @rtc {
        reverse_proxy livekit:7880
    }

    @twirp path /twirp /twirp/*
    handle @twirp {
        reverse_proxy livekit:7880
    }
    
    handle {
        try_files {path} /index.html
        file_server
    }
}
