:80 {
    root * /srv
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss: http: https:; img-src 'self' data:; media-src 'self' blob:;"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy APIs to Go Backend
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /ws/* {
        reverse_proxy backend:8080
    }

    # Proxy WebRTC Signaling to LiveKit
    handle /rtc/* {
        reverse_proxy livekit:7880
    }
    handle /twirp/* {
        reverse_proxy livekit:7880
    }
    
    # Only apply static file routing if it didn't match the API/WS handlers above
    handle {
        try_files {path} /index.html
        file_server
    }
}
